<?xml version="1.0" encoding="UTF-8"?>
<!--
  ================================================================
  AUTO-GENERATED by scripts/generate_world.py from config/zones.yaml
  DO NOT EDIT aware_expo.sdf BY HAND: edit the YAML or this template,
  then regenerate.
  ================================================================
  Template syntax (Jinja2), see the tags used below:
    double curly braces      -> insert a value
    "for" block tags         -> repeat a block for each item
    "if" block tags          -> include a block only when a condition is true
-->
<sdf version="1.9">
  <world name="{{ venue.name }}">

    <!-- 1. PHYSICS: 250 Hz, lockstep with PX4 (unchanged from step 1) -->
    <physics type="ode">
      <max_step_size>0.004</max_step_size>
      <real_time_factor>1.0</real_time_factor>
      <real_time_update_rate>250</real_time_update_rate>
    </physics>
    <gravity>0 0 -9.8</gravity>
    <magnetic_field>6e-06 2.3e-05 -4.2e-05</magnetic_field>
    <atmosphere type="adiabatic"/>

    <!-- 2. SCENE -->
    <scene>
      <grid>false</grid>
      <ambient>0.5 0.5 0.5 1</ambient>
      <background>0.72 0.82 0.92 1</background>
      <shadows>true</shadows>
    </scene>

    <!-- 3. OUTSIDE GROUND (sand) -->
    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry><plane><normal>0 0 1</normal><size>1 1</size></plane></geometry>
        </collision>
        <visual name="visual">
          <geometry><plane><normal>0 0 1</normal><size>500 500</size></plane></geometry>
          <material>
            <ambient>0.76 0.66 0.50 1</ambient>
            <diffuse>0.76 0.66 0.50 1</diffuse>
            <specular>0.1 0.1 0.1 1</specular>
          </material>
        </visual>
      </link>
    </model>

    <!-- 4. EXPO FLOOR: {{ venue.floor_size[0] }} x {{ venue.floor_size[1] }} m, top surface at z = 0.02 -->
    <model name="expo_floor">
      <static>true</static>
      <pose>0 0 0.01 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>{{ venue.floor_size[0] }} {{ venue.floor_size[1] }} 0.02</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>{{ venue.floor_size[0] }} {{ venue.floor_size[1] }} 0.02</size></box></geometry>
          <material>
            <ambient>0.85 0.85 0.82 1</ambient>
            <diffuse>0.85 0.85 0.82 1</diffuse>
            <specular>0.2 0.2 0.2 1</specular>
          </material>
        </visual>
      </link>
    </model>

    <!-- ============================================================
         5. BOOTHS: one <model> each, parts placed in the booth's LOCAL frame.
         Local frame: origin = booth center on the floor, +x = opening side.
         The model <pose> (x, y, yaw) then moves and rotates the whole booth,
         like building furniture on your desk and then carrying it into place.
         ============================================================ -->
{% for b in booths %}
    <model name="{{ b.id }}">
      <static>true</static>
      <pose>{{ b.x }} {{ b.y }} 0.02 0 0 {{ b.yaw }}</pose>
      <link name="link">
{% for p in b.parts %}
        <collision name="{{ p.name }}_col">
          <pose>{{ p.pose }}</pose>
          <geometry><box><size>{{ p.size }}</size></box></geometry>
        </collision>
        <visual name="{{ p.name }}_vis">
          <pose>{{ p.pose }}</pose>
          <geometry><box><size>{{ p.size }}</size></box></geometry>
          <material>
            <ambient>{{ p.color }} 1</ambient>
            <diffuse>{{ p.color }} 1</diffuse>
            <specular>0.1 0.1 0.1 1</specular>
          </material>
        </visual>
{% endfor %}
      </link>
    </model>
{% endfor %}

    <!-- 6. STAGE: a raised platform in the plaza -->
    <model name="stage">
      <static>true</static>
      <pose>{{ stage.x }} {{ stage.y }} 0.02 0 0 {{ stage.yaw }}</pose>
      <link name="link">
        <collision name="platform_col">
          <pose>0 0 {{ stage.h / 2 }} 0 0 0</pose>
          <geometry><box><size>{{ stage.sx }} {{ stage.sy }} {{ stage.h }}</size></box></geometry>
        </collision>
        <visual name="platform_vis">
          <pose>0 0 {{ stage.h / 2 }} 0 0 0</pose>
          <geometry><box><size>{{ stage.sx }} {{ stage.sy }} {{ stage.h }}</size></box></geometry>
          <material><ambient>0.25 0.25 0.3 1</ambient><diffuse>0.25 0.25 0.3 1</diffuse></material>
        </visual>
        <visual name="backdrop_vis">
          <pose>0 {{ stage.sy / 2 - 0.1 }} {{ stage.h + 2 }} 0 0 0</pose>
          <geometry><box><size>{{ stage.sx }} 0.2 4</size></box></geometry>
          <material><ambient>0.1 0.35 0.45 1</ambient><diffuse>0.1 0.35 0.45 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- 7. ENTRANCE GATE: two pillars and a beam across the top -->
    <model name="entrance_gate">
      <static>true</static>
      <pose>{{ gate.x }} {{ gate.y }} 0.02 0 0 {{ gate.yaw }}</pose>
      <link name="link">
{% for side in [-1, 1] %}
        <collision name="pillar_{{ loop.index }}_col">
          <pose>{{ side * gate.width / 2 }} 0 {{ gate.height / 2 }} 0 0 0</pose>
          <geometry><box><size>0.6 0.6 {{ gate.height }}</size></box></geometry>
        </collision>
        <visual name="pillar_{{ loop.index }}_vis">
          <pose>{{ side * gate.width / 2 }} 0 {{ gate.height / 2 }} 0 0 0</pose>
          <geometry><box><size>0.6 0.6 {{ gate.height }}</size></box></geometry>
          <material><ambient>0.9 0.9 0.9 1</ambient><diffuse>0.9 0.9 0.9 1</diffuse></material>
        </visual>
{% endfor %}
        <visual name="beam_vis">
          <pose>0 0 {{ gate.height + 0.4 }} 0 0 0</pose>
          <geometry><box><size>{{ gate.width + 0.6 }} 0.6 0.8</size></box></geometry>
          <material><ambient>0.1 0.35 0.45 1</ambient><diffuse>0.1 0.35 0.45 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- ============================================================
         7b. LAUNCH PAD: dark square with a white "H" (helipad marking).
         Base has collision (the drone stands on it); the H is visual-only,
         painted 1 mm above the base so it doesn't z-fight.
         ============================================================ -->
    <model name="launch_pad">
      <static>true</static>
      <pose>{{ pad.x }} {{ pad.y }} 0 0 0 {{ pad.yaw }}</pose>
      <link name="link">
        <collision name="base_col">
          <pose>0 0 0.025 0 0 0</pose>
          <geometry><box><size>{{ pad.size }} {{ pad.size }} 0.05</size></box></geometry>
        </collision>
        <visual name="base_vis">
          <pose>0 0 0.025 0 0 0</pose>
          <geometry><box><size>{{ pad.size }} {{ pad.size }} 0.05</size></box></geometry>
          <material><ambient>0.15 0.15 0.17 1</ambient><diffuse>0.15 0.15 0.17 1</diffuse></material>
        </visual>
{% for name, px, sx, sy in [("h_left", -pad.size * 0.2, pad.size * 0.1, pad.size * 0.6),
                            ("h_right", pad.size * 0.2, pad.size * 0.1, pad.size * 0.6),
                            ("h_bar", 0, pad.size * 0.4, pad.size * 0.1)] %}
        <visual name="{{ name }}">
          <pose>{{ px }} 0 0.051 0 0 0</pose>
          <geometry><box><size>{{ sx }} {{ sy }} 0.001</size></box></geometry>
          <material><ambient>0.95 0.95 0.95 1</ambient><diffuse>0.95 0.95 0.95 1</diffuse></material>
        </visual>
{% endfor %}
      </link>
    </model>

{% if debug_zones %}
    <!-- ============================================================
         8. DEBUG ZONES: VISUAL-ONLY, semi-transparent floor overlays.
         No <collision>: people and the drone pass through them, and
         physics ignores them. Generate WITHOUT the debug-zones flag for the
         real demo, because the AI camera should not see painted zones.
         ============================================================ -->
    <model name="debug_zones">
      <static>true</static>
      <link name="link">
{% for z in zones %}
        <visual name="zone_{{ z.id }}">
          <pose>0 0 0.025 0 0 0</pose>
          <geometry>
            <polyline>
{% for pt in z.polygon %}
              <point>{{ pt[0] }} {{ pt[1] }}</point>
{% endfor %}
              <height>0.005</height>
            </polyline>
          </geometry>
          <transparency>0.5</transparency>
          <cast_shadows>false</cast_shadows>
          <material>
            <ambient>{{ z.color }} 1</ambient>
            <diffuse>{{ z.color }} 1</diffuse>
          </material>
        </visual>
{% endfor %}
      </link>
    </model>
{% endif %}

    <!-- ============================================================
         9. ACTORS (scenario: {{ scenario }}, {{ actors | length }} people)
         An actor = a SKIN (the 3D person + skeleton) + an ANIMATION
         (how the skeleton moves) + a SCRIPT (where it goes and when).
         - Actors have no physics: they pass through each other and are
           not pushed by anything, but cameras DO see them.
         - trajectory type must match the animation name ("walk").
         - interpolate_x: the walk cycle is synced to the distance moved,
           so feet don't slide. A walker who pauses mid-route freezes mid-step.
           But an actor that NEVER moves has zero distance, so Gazebo falls
           back to playing the walk on the clock = walking in place. That's
           why standers get a separate idle/talk animation (talk_b).
         - tension 1.0 = straight lines between waypoints (0 = smooth
           curves). Straight lines match our obstacle check in crowd.py.
         ============================================================ -->
{% for a in actors %}
    <actor name="{{ a.name }}">
      <skin>
        <filename>{{ a.skin }}</filename>
        <scale>{{ a.scale }}</scale>
      </skin>
      <animation name="{{ a.anim }}">
        <filename>{{ a.anim_file }}</filename>
        <scale>{{ a.scale }}</scale>
        <interpolate_x>{{ a.interpolate_x }}</interpolate_x>
      </animation>
      <script>
        <loop>{{ a.loop }}</loop>
        <delay_start>0</delay_start>
        <auto_start>true</auto_start>
        <trajectory id="0" type="{{ a.anim }}" tension="1.0">
{% for w in a.waypoints %}
          <waypoint><time>{{ w.time }}</time><pose>{{ w.pose }}</pose></waypoint>
{% endfor %}
        </trajectory>
      </script>
    </actor>
{% endfor %}

    <!-- 10. SUN -->
    <light name="sun" type="directional">
      <pose>0 0 500 0 0 0</pose>
      <cast_shadows>true</cast_shadows>
      <intensity>1</intensity>
      <direction>0.3 0.4 -0.87</direction>
      <diffuse>0.95 0.93 0.88 1</diffuse>
      <specular>0.3 0.3 0.3 1</specular>
    </light>

    <!-- 11. LOCATION ON EARTH -->
    <spherical_coordinates>
      <surface_model>EARTH_WGS84</surface_model>
      <world_frame_orientation>ENU</world_frame_orientation>
      <latitude_deg>{{ venue.location.latitude }}</latitude_deg>
      <longitude_deg>{{ venue.location.longitude }}</longitude_deg>
      <elevation>{{ venue.location.elevation }}</elevation>
      <heading_deg>0</heading_deg>
    </spherical_coordinates>

  </world>
</sdf>
